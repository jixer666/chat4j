<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.abc.chat4j.platform.mapper.GroupMemberMapper">

    <resultMap type="GroupMember" id="RoomMemberResult">
        <result property="groupMemberId"    column="group_member_id"    />
        <result property="userId"    column="user_id"    />
        <result property="groupId"    column="group_id"    />
        <result property="roomId"    column="room_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="status"    column="status"    />
        <result property="ver"    column="ver"    />
    </resultMap>

    <sql id="selectRoomMemberVo">
        select room_member_id, user_id, group_id, room_id, create_time, update_time, status, ver from tb_group_member
    </sql>
    <select id="selectByRoomIdAndUid" resultMap="RoomMemberResult">
        select * from tb_group_member
        where room_id = #{roomId} and user_id = #{userId}
    </select>
    <select id="selectGroupMemberByRoomId" resultMap="RoomMemberResult">
        select * from tb_group_member
        where room_id = #{roomId}
    </select>
    <insert id="insertGroupMemberBatch" parameterType="list">
        insert into tb_group_member (
        group_member_id,
        user_id,
        group_id,
        room_id,
        create_time,
        update_time,
        status,
        ver
        ) values
        <foreach collection="groupMemberList" item="item" separator=",">
            (
            #{item.groupMemberId},
            #{item.userId},
            #{item.groupId},
            #{item.roomId},
            #{item.createTime},
            #{item.updateTime},
            #{item.status},
            #{item.ver}
            )
        </foreach>
    </insert>
    <select id="selectGroupMemberByRoomIdAndUserIdList" resultMap="RoomMemberResult">
        select * from tb_group_member
        where room_id = #{roomId} and user_id in
        <foreach collection="userIdList" open="(" close=")" separator="," item="item">
            #{item}
        </foreach>
    </select>


</mapper>
